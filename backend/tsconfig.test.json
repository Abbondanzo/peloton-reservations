{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Tests import shared's fixtures from source, which sits outside backend/.
    "rootDir": "..",
    "types": ["vitest/globals", "node"],
    "paths": {
      "shared": ["../shared/src/index.ts"],
      "shared/testing": ["../shared/src/testing/fixtures.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "build"]
}
