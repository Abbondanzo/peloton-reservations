{
  "name": "peloton-reservations",
  "description": "Frontend code for interacting with Peloton schedule and user account",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sentry-sourcemaps": "sentry-cli sourcemaps inject --org titus-design --project peloton-reservations ./dist && sentry-cli sourcemaps upload --org titus-design --project peloton-reservations ./dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.9.0",
    "@sentry/react": "10.11.0",
    "firebase": "12.2.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-redux": "9.2.0",
    "react-router-dom": "7.9.1",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@sentry/cli": "2.55.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "^30.0.1",
    "shared": "workspace:*",
    "typescript": "5.8.3",
    "typescript-eslint": "8.39.1",
    "vite": "7.1.5",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "^3.2.7"
  }
}
